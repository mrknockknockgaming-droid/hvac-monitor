#!/bin/sh
# manage.py inside the LXC, as the service user and with the service settings, e.g.
#   fullscope-manage list
#   fullscope-manage create-user ...
cd /opt/fullscope || exit 1
exec runuser -u fullscope -- env FULLSCOPE_ENV_FILE=/etc/fullscope/fullscope.env \
  /opt/fullscope/.venv/bin/python manage.py "$@"
