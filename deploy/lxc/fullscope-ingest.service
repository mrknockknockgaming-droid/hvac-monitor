[Unit]
Description=Fullscope ingest worker (MQTT to database, alerts, nightly backup)
After=network-online.target mosquitto.service
Wants=network-online.target mosquitto.service

[Service]
User=fullscope
Group=fullscope
Environment=FULLSCOPE_ENV_FILE=/etc/fullscope/fullscope.env
Environment=FULLSCOPE_HOME=/opt/fullscope
WorkingDirectory=/opt/fullscope
ExecStart=/opt/fullscope/bin/fullscope ingest
Restart=always
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
