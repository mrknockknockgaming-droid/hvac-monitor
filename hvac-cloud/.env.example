# Copy to .env (never commit .env) and set real values.
POSTGRES_PASSWORD=change-me
# Broker accounts (Docker): the ingest worker and API use the backend one, the nodes the other
# (put MQTT_NODES_USER / MQTT_NODES_PASS in the nodes' config.h). Changing one needs a restart.
MQTT_BACKEND_USER=backend
MQTT_BACKEND_PASS=change-me
MQTT_NODES_USER=nodes
MQTT_NODES_PASS=change-me

# Alert email (optional; leave SMTP_HOST empty for no email). Alerts go to the account's email.
# Gmail: smtp.gmail.com, port 587, your address, and an App Password (not your normal password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Where links in alert emails point
APP_URL=http://localhost:8000/app/

# Nightly backup and cleanup of dev.db (SQLite)
BACKUP_KEEP=7
FULL_DETAIL_DAYS=30
KEEP_DAYS=365
